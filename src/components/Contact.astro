---
import { t, urls, type Lang } from '~/i18n';
import { BUSINESS } from '~/data/business';
import { contactLink } from '~/lib/whatsapp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
---

<section class="contact section" id="contact">
  <div class="wrap">
    <div class="contact__panel">
      <div class="contact__copy">
        <p class="eyebrow">{ui.contact.eyebrow}</p>
        <h2>{ui.contact.title}</h2>
        <p class="lede">{ui.contact.lead}</p>

        <dl class="contact__list">
          <div>
            <dt>{ui.contact.whatsapp}</dt>
            <dd>
              <a href={contactLink(lang)} target="_blank" rel="noopener noreferrer">
                {BUSINESS.whatsappDisplay}
              </a>
            </dd>
          </div>
          <div>
            <dt>{ui.contact.address}</dt>
            <dd><address>{BUSINESS.address}</address><a class="link contact__map" href="https://share.google/ytT4cp5j9NzMtVQ3M" target="_blank" rel="noopener noreferrer">{ui.contact.viewOnMaps}</a></dd>
          </div>
        </dl>

        <div class="contact__delivery">
          <p class="contact__delivery-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 16V6.5A1.5 1.5 0 0 1 4.5 5H14v11M3 16h2m6 0h2m-4 0h.01M14 9h3.6a2 2 0 0 1 1.7.95L21 12.8V16h-2m-5 0h-1" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {ui.delivery.title}
          </p>
          <p class="contact__delivery-lead">{ui.contact.deliveryLead}</p>
          <ul class="contact__points">
            {ui.delivery.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>

        <p class="contact__note">{ui.contact.note}</p>
        <p class="contact__note contact__note--dim">{ui.contact.hoursNote}</p>
      </div>

      <div class="contact__cta">
        <a class="btn btn--wa btn--block" href={contactLink(lang)} target="_blank" rel="noopener noreferrer">
          {ui.contact.whatsappCta}
        </a>
        <a class="btn btn--ghost btn--block" href={urls.fleet(lang)}>{ui.fleet.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    display: grid;
    gap: var(--sp-8);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(212 175 55 / 0.1), transparent 60%),
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 45%),
      var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-3);
  }

  @media (min-width: 900px) {
    .contact__panel {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      align-items: center;
      gap: clamp(2rem, 1rem + 4vw, 4rem);
    }
  }

  .contact__copy h2 {
    margin-block: var(--sp-3) var(--sp-3);
  }

  .contact__list {
    display: grid;
    gap: var(--sp-4);
    margin-block: var(--sp-6) 0;
  }

  .contact__list dt {
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-block-end: 0.25rem;
  }

  :global([dir='rtl']) .contact__list dt {
    letter-spacing: 0;
  }

  .contact__list dd {
    margin: 0;
    font-size: var(--fs-base);
    color: var(--ink);
  }

  .contact__list a {
    color: var(--gold);
    font-weight: 600;
  }

  .contact__list address {
    font-style: normal;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }

  .contact__delivery {
    margin-block-start: var(--sp-6);
    padding: var(--sp-4) var(--sp-5);
    background:
      linear-gradient(180deg, rgb(212 175 55 / 0.07), transparent 70%),
      rgb(255 255 255 / 0.02);
    border: 1px solid rgb(212 175 55 / 0.22);
    border-radius: var(--r-2);
  }

  .contact__delivery-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--gold);
  }

  .contact__delivery-badge svg {
    flex: none;
  }

  .contact__delivery-lead {
    margin-block: var(--sp-2) 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .contact__points {
    display: grid;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__points li {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink-3);
  }

  /* The marker is a plain dot rather than a disc, so it stays on the
     correct side of the line in both reading directions. */
  .contact__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 5px;
    block-size: 5px;
    background: var(--gold);
    border-radius: 50%;
    opacity: 0.75;
  }

  .contact__note {
    margin-block-start: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  .contact__note--dim {
    color: var(--ink-4);
    font-size: var(--fs-xs);
  }

  .contact__cta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
</style>
