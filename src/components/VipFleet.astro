---
import { t, type Lang } from '~/i18n';
import { waLink } from '~/data/business';

interface Props {
  lang: Lang;
  /** Tighter spacing and type, for use inside an article body. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const ui = t(lang);
const wa = waLink(ui.vip.whatsapp);
---

{/*
  On-demand luxury inventory. These cars are sourced per request, so this is a
  prompt to enquire, never a bookable card — the fleet grid stays exactly what
  the agency owns and can hand over on the spot.

  Kept to a single row on purpose: this sits under the fleet grid, so it has to
  read as a strip rather than another section.
*/}
<div class:list={['vip', compact && 'vip--compact']}>
  <div class="vip__body">
    <p class="eyebrow">{ui.vip.eyebrow}</p>
    <h2 class="vip__title">{ui.vip.title}</h2>
    <p class="vip__text">{ui.vip.text}</p>
  </div>
  <p class="vip__actions">
    <a class="btn btn--gold" href={wa} target="_blank" rel="noopener noreferrer">
      {ui.vip.cta}
    </a>
  </p>
</div>

<style>
  .vip {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    padding: clamp(1rem, 0.85rem + 0.8vw, 1.5rem) clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border-radius: 1.1rem;
    border: 1px solid rgb(212 175 55 / 0.3);
    background:
      radial-gradient(130% 150% at 88% -20%, rgb(212 175 55 / 0.18), transparent 58%),
      radial-gradient(90% 130% at 6% 120%, rgb(212 175 55 / 0.1), transparent 60%),
      linear-gradient(180deg, rgb(12 12 16 / 0.9), rgb(11 11 14 / 0.75));
    backdrop-filter: blur(18px);
    box-shadow:
      0 18px 44px rgb(0 0 0 / 0.4),
      inset 0 1px 0 rgb(255 255 255 / 0.07);
  }

  /* Gold hairline along the top edge — the "accent" without a border. */
  .vip::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 14%;
    block-size: 1px;
    background: linear-gradient(to right, transparent, rgb(212 175 55 / 0.75), transparent);
  }

  .vip__body {
    flex: 1 1 20rem;
    min-inline-size: 0;
  }

  .vip__title {
    font-size: var(--fs-lg);
    margin: 0;
  }

  .vip--compact .vip__title {
    font-size: var(--fs-base);
  }

  .vip__text {
    max-inline-size: 58ch;
    margin-block: var(--sp-1) 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .vip--compact .vip__text {
    font-size: var(--fs-sm);
  }

  .vip__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: 0;
    margin-inline-start: auto;
  }
</style>
