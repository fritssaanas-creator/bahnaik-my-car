---
import { t, urls, LANG_LABEL, LANG_SHORT, LANGS, type Lang } from '~/i18n';
import { BUSINESS } from '~/data/business';
import { contactLink } from '~/lib/whatsapp';

interface Props {
  lang: Lang;
  /**
   * Equivalent page in every language. Omitted on pages that are not real
   * equivalents (404), which hide the switcher and offer language homepages
   * of their own instead.
   */
  alternates?: Record<Lang, string>;
  /** Current path, used to mark the active nav item. */
  current: string;
}

const { lang, alternates, current } = Astro.props;
const ui = t(lang);

const links = [
  { href: urls.fleet(lang), label: ui.nav.fleet, key: 'fleet' },
  { href: urls.kenitra(lang), label: ui.nav.kenitra, key: 'kenitra' },
  { href: urls.maroc(lang), label: ui.nav.maroc, key: 'maroc' },
  { href: urls.mre(lang), label: ui.nav.mre, key: 'mre' },
  { href: urls.blog(lang), label: ui.nav.blog, key: 'blog' },
  { href: urls.faq(lang), label: ui.nav.faq, key: 'faq' },
  { href: urls.contact(lang), label: ui.nav.contact, key: 'contact' },
];

const isActive = (key: string) => current.includes(key) || current.endsWith(key);
---

<header class="hdr">
  <div class="hdr__bar wrap">
    <a class="brand" href={urls.home(lang)} aria-label={`${BUSINESS.name} — ${ui.brand.city}`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
          <path d="M16 2.6 4 9v14l12 6.4L28 23V9L16 2.6Z" stroke="currentColor" stroke-width="1.3" opacity=".55" />
          <path d="M16 8.4 9.4 12v8L16 23.6 22.6 20v-8L16 8.4Z" fill="currentColor" opacity=".9" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">{BUSINESS.name}</span>
        <span class="brand__city">{ui.brand.city}</span>
      </span>
    </a>

    <nav class="hdr__nav" aria-label={ui.nav.menu}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__actions">
      {
        alternates && (
          <details class="lang">
            <summary aria-label={ui.nav.langLabel} title={ui.nav.langLabel}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18M12 3c2.6 2.6 2.6 15 0 18M12 3c-2.6 2.6-2.6 15 0 18"></path>
              </svg>
              <span>{LANG_SHORT[lang]}</span>
            </summary>
            <ul class="lang__list">
              {
                LANGS.map((l) => (
                  <li>
                    <a
                      href={alternates[l]}
                      hreflang={l}
                      lang={l}
                      aria-current={l === lang ? 'true' : undefined}
                    >
                      {LANG_LABEL[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        )
      }

      <a class="btn btn--wa btn--sm hdr__cta" href={contactLink(lang)} target="_blank" rel="noopener noreferrer">
        {ui.nav.primary}
      </a>

      <button class="hdr__burger" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-panel" aria-label={ui.nav.open}>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="hdr__panel" id="nav-panel" data-nav-panel hidden>
    <ul class="wrap">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="hdr__panel-lang">
        <span class="eyebrow">{ui.nav.langLabel}</span>
        <div class="row">
          {
            LANGS.map((l) => (
              <a
                class="chip"
                href={alternates?.[l] ?? urls.home(l)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
              >
                {LANG_LABEL[l]}
              </a>
            ))
          }
        </div>
      </li>
      <li>
        <a class="btn btn--wa btn--block" href={contactLink(lang)} target="_blank" rel="noopener noreferrer">
          {ui.nav.primary}
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--black) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border-block-end: 1px solid var(--hairline-soft);
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-block-size: 3.5rem;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-inline-end: auto;
    flex: none;
  }

  .brand__mark {
    color: var(--gold);
    display: grid;
    place-items: center;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  :global([dir='rtl']) .brand__name {
    letter-spacing: 0;
  }

  .brand__city {
    font-size: var(--fs-2xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
  }

  :global([dir='rtl']) .brand__city {
    letter-spacing: 0;
  }

  /* Desktop nav */
  .hdr__nav {
    display: none;
  }

  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.2rem + 0.9vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hdr__nav a {
    position: relative;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-block: 0.35rem;
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
  }

  :global([dir='rtl']) .hdr__nav a {
    letter-spacing: 0;
  }

  .hdr__nav a::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 1px;
    background: var(--gold);
    transition: inline-size var(--dur) var(--ease);
  }

  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--ink);
  }

  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current='page']::after {
    inline-size: 100%;
  }

  /* Actions */
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hdr__cta {
    display: none;
  }

  /* Language switcher */
  .lang {
    position: relative;
  }

  .lang summary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    list-style: none;
    padding: 0.375rem 0.5rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-2);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover {
    border-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .lang[open] summary {
    border-color: var(--gold);
    color: var(--gold);
  }

  .lang__list {
    position: absolute;
    inset-block-start: calc(100% + 0.4rem);
    inset-inline-end: 0;
    min-inline-size: 9.5rem;
    list-style: none;
    margin: 0;
    padding: var(--sp-1);
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-2);
    box-shadow: var(--shadow-3);
  }

  .lang__list a {
    display: block;
    padding: 0.45rem 0.6rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
    border-radius: var(--r-1);
  }

  .lang__list a:hover {
    background: rgb(255 255 255 / 0.05);
    color: var(--ink);
  }

  .lang__list a[aria-current='true'] {
    color: var(--gold);
  }

  /* Burger */
  .hdr__burger {
    display: grid;
    place-content: center;
    gap: 5px;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-2);
  }

  .hdr__burger span {
    display: block;
    inline-size: 1rem;
    block-size: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease);
  }

  .hdr__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .hdr__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile panel */
  .hdr__panel {
    position: fixed;
    inset: 3.5rem 0 0;
    z-index: 9999;
    overflow-y: auto;
    background: var(--bg);
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: var(--sp-4) var(--sp-10);
  }

  .hdr__panel[hidden] {
    display: none;
  }

  .hdr__panel ul {
    list-style: none;
    margin: 0;
    padding-inline: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .hdr__panel a:not(.btn):not(.chip) {
    display: block;
    padding: 0.7rem 0;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink-2);
    border-block-end: 1px solid var(--hairline-soft);
  }

  .hdr__panel a[aria-current='page'] {
    color: var(--gold);
  }

  .hdr__panel-lang {
    margin-block: var(--sp-4) var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  @media (min-width: 900px) {
    .hdr__nav {
      display: block;
    }
    .hdr__burger,
    .hdr__panel {
      display: none;
    }
    .hdr__cta {
      display: inline-flex;
    }
  }
</style>
