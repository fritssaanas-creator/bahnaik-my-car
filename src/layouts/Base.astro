---
import '~/styles/global.css';
import {
  DEFAULT_LANG,
  HTML_LANG,
  HREFLANG,
  LANGS,
  OG_LOCALE,
  dirOf,
  type Lang,
} from '~/i18n';
import { BUSINESS, SITE, absolute } from '~/data/business';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { baseGraph, graph } from '~/lib/schema';
import { contactLink } from '~/lib/whatsapp';
export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * Equivalent page in every language — drives canonical + hreflang. Omit only
   * on pages that must not be indexed (404), where hreflang would be wrong.
   */
  alternates?: Record<Lang, string>;
  /** Current path, used for canonical. Defaults to the French URL's own lang. */
  path?: string;
  image?: string;
  noindex?: boolean;
  /** JSON-LD nodes appended to the base graph. */
  schema?: unknown[];
  /** Suppress the floating mobile WhatsApp bar (used on the home hero). */
  floating?: boolean;
  bodyClass?: string;
}

const {
  lang,
  title,
  description,
  alternates,
  path,
  image = SITE.defaultImage,
  noindex = false,
  schema = [],
  floating = true,
  bodyClass,
} = Astro.props;

const canonical = path ?? alternates?.[lang];
const ogImage = absolute(image);
const isArabic = lang === 'ar';
---

<!doctype html>
<html lang={HTML_LANG[lang]} dir={dirOf(lang)}>
  <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="google-site-verification" content="IjsPVeoADhyt_j6kBNWQ1vmQ4Pl3NeHYx_2tmwhqaZk" />
      <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={absolute(canonical)} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* hreflang — every language, plus x-default pointing at French. */}
    {
      alternates && (
        <>
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={HREFLANG[l]} href={absolute(alternates[l])} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(alternates[DEFAULT_LANG])} />
        </>
      )
    }

    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="author" content={BUSINESS.name} />
    <meta name="geo.region" content="MA-KEN" />
    <meta name="geo.placename" content={BUSINESS.city} />
    <meta name="format-detection" content="telephone=no" />
    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={absolute(canonical)} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${BUSINESS.city}`} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      LANGS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
      ))
    }

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={graph([...baseGraph(lang, alternates), ...schema])} is:inline />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">{isArabic ? 'تخطي إلى المحتوى' : lang === 'en' ? 'Skip to main content' : 'Aller au contenu principal'}</a>
    <Header lang={lang} alternates={alternates} current={canonical ?? ''} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {
      floating && (
        <a
          class="wa-float"
          href={contactLink(lang)}
          target="_blank"
          rel="noopener noreferrer"
          data-astro-prefetch="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.71-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.17 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z" />
          </svg>
          <span>WhatsApp</span>
        </a>
      )
    }
    <script>
      // Mobile navigation: one small progressive-enhancement script, no framework.
      const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
      const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          panel.toggleAttribute('data-open', open);
          panel.toggleAttribute('hidden', !open);
          document.documentElement.style.overflow = open ? 'hidden' : '';
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        panel.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
        addEventListener('resize', () => {
          if (innerWidth >= 900) setOpen(false);
        });
      }
    </script>
  </body>
</html>
