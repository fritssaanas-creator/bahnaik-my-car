---
import { t, urls, type Lang } from '~/i18n';
import { fleetSorted } from '~/data/fleet';
import { metaFor } from '~/lib/seo';
import { breadcrumbSchema, faqSchema, fleetSchema, serviceSchema } from '~/lib/schema';
import { getBlogIndex } from '~/lib/blog';
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import TrustBar from '~/components/TrustBar.astro';
import VehicleCard from '~/components/VehicleCard.astro';
import VipFleet from '~/components/VipFleet.astro';
import BookingForm from '~/components/BookingForm.astro';
import WhyUs from '~/components/WhyUs.astro';
import HowItWorks from '~/components/HowItWorks.astro';
import Faq from '~/components/Faq.astro';
import PostCard from '~/components/PostCard.astro';
import Contact from '~/components/Contact.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const meta = metaFor('home', lang);

const alternates = { fr: urls.home('fr'), en: urls.home('en'), ar: urls.home('ar') };
const vehicles = fleetSorted();
const { pillars } = await getBlogIndex(lang);
const latest = pillars.slice(0, 3);

const schema = [
  fleetSchema(lang),
  serviceSchema(lang),
  faqSchema(ui.faq.items),
  breadcrumbSchema([{ name: ui.misc.breadcrumbHome, href: urls.home(lang) }], lang),
];
---

<Base
  lang={lang}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  path={urls.home(lang)}
  schema={schema}
>
  <Hero lang={lang} />

  {/* Confidence before choice: five verified benefits, then the cars. */}
  <TrustBar lang={lang} />

  {/* Fleet sits immediately after the hero: it is the second thing a visitor
      needs, and the primary CTA scrolls straight to it. */}
  <section class="section section--tight" id="fleet">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{ui.fleet.eyebrow}</p>
        <div class="section-head__row">
          <h2>{ui.fleet.homeTitle}</h2>
          <a class="link" href={urls.fleet(lang)}>{ui.fleet.cta} →</a>
        </div>
        <p class="lede">{ui.fleet.homeLead}</p>
      </div>

      <div class="fleet__grid">
        {vehicles.map((v, i) => <VehicleCard vehicle={v} lang={lang} featured={i === 0} />)}
      </div>

      {/* Once a visitor has seen what we actually own, the honest next question
          is "can you get me something else?". Answered here, before the booking
          form, without touching the core catalog. */}
      <div class="fleet__vip">
        <VipFleet lang={lang} />
      </div>
    </div>
  </section>

  {/* Availability check and free delivery, side by side: the two things that
      remove hesitation right after browsing the cars. */}
  <section class="section section--tight" id="disponibilite">
    <div class="wrap reserve">
      <div class="reserve__copy">
        <p class="eyebrow">{ui.booking.title}</p>
        <h2>{ui.booking.title}</h2>
        <p class="lede">{ui.booking.lead}</p>

        <div class="delivery">
          <p class="delivery__badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" stroke-linejoin="round"></path>
              <circle cx="7" cy="18" r="1.8"></circle>
              <circle cx="17.5" cy="18" r="1.8"></circle>
            </svg>
            {ui.delivery.title}
          </p>
          <p class="delivery__text">{ui.delivery.text}</p>
        </div>
      </div>

      <div class="reserve__form">
        <BookingForm lang={lang} id="home-booking" />
      </div>
    </div>
  </section>

  <WhyUs lang={lang} />
  <HowItWorks lang={lang} />
  <Faq lang={lang} />

  {
    latest.length > 0 && (
      <section class="section" id="blog">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">{ui.blog.eyebrow}</p>
            <div class="section-head__row">
              <h2>{ui.blog.title}</h2>
              <a class="link" href={urls.blog(lang)}>
                {ui.blog.all} →
              </a>
            </div>
          </div>
          <div class="grid grid--3">
            {latest.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Contact lang={lang} />
</Base>

<style>
  /* Fleet: one column on phones, two on tablets, three on desktop. */
  .fleet__grid {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 620px) {
    .fleet__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .fleet__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-5);
    }
  }

  .fleet__vip {
    margin-block-start: var(--sp-5);
  }

  .reserve {
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }

  @media (min-width: 900px) {
    .reserve {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 3.5rem);
    }
  }

  .reserve__copy h2 {
    margin-block: var(--sp-3) var(--sp-3);
  }

  .delivery {
    margin-block-start: var(--sp-6);
    padding: var(--sp-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-3);
    background: color-mix(in srgb, var(--gold) 5%, transparent);
  }

  .delivery__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  :global([dir='rtl']) .delivery__badge {
    letter-spacing: 0;
  }

  .delivery__text {
    margin-block-start: var(--sp-2);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--ink-2);
  }
</style>
